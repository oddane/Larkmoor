{
  "color": {
    "$type": "color",
    "bg": {
      "$value": "{palette.white}",
      "$description": "Page background."
    },
    "bg-subtle": {
      "$value": "{palette.neutral.50}",
      "$description": "Quiet panels and demos."
    },
    "surface": {
      "$value": "{palette.white}",
      "$description": "Cards inside subtle panels."
    },
    "control-track": {
      "$value": "{palette.neutral.100}",
      "$description": "Track behind segmented controls and switches."
    },
    "text": {
      "$value": "{palette.neutral.900}",
      "$description": "Primary text and headings."
    },
    "text-secondary": {
      "$value": "{palette.neutral.700}",
      "$description": "Body copy under headings."
    },
    "text-muted": {
      "$value": "{palette.neutral.500}",
      "$description": "Metadata and help text. AA on bg and bg-subtle."
    },
    "text-label": {
      "$value": "{palette.gold.700}",
      "$description": "Section eyebrows."
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0784,
          0.1412,
          0.1098
        ],
        "alpha": 0.11,
        "hex": "#14241c"
      },
      "$description": "Hairlines between rows."
    },
    "border-strong": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0784,
          0.1412,
          0.1098
        ],
        "alpha": 0.2,
        "hex": "#14241c"
      },
      "$description": "Component boundaries that must be seen (3:1 not required for decorative rules)."
    },
    "accent": {
      "$value": "{palette.green.600}",
      "$description": "Brand accent: emphasis, active state, progress."
    },
    "accent-hover": {
      "$value": "{palette.green.700}"
    },
    "accent-text": {
      "$value": "{palette.green.600}",
      "$description": "Accent used as text. AA on bg."
    },
    "on-accent": {
      "$value": "{palette.white}"
    },
    "action": {
      "$value": "{palette.neutral.900}",
      "$description": "Primary button fill."
    },
    "on-action": {
      "$value": "{palette.white}"
    },
    "focus": {
      "$value": "{palette.green.600}",
      "$description": "Focus ring."
    },
    "brand": {
      "$value": "{palette.blue.600}",
      "$description": "Product brand mark."
    },
    "success": {
      "$value": "{palette.green.650}"
    },
    "warning": {
      "$value": "{palette.gold.700}"
    },
    "danger": {
      "$value": "{palette.red.600}"
    },
    "header-scrim": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1.0,
          1.0,
          1.0
        ],
        "alpha": 0.78,
        "hex": "#ffffff"
      },
      "$description": "Header background once the page scrolls."
    }
  },
  "text": {
    "$description": "Semantic type roles. Visual size is independent of heading level.",
    "display": {
      "family": {
        "$value": "{font.family.display}"
      },
      "size": {
        "$value": "{font.size.display}"
      },
      "weight": {
        "$value": "{font.weight.medium}"
      },
      "line-height": {
        "$type": "number",
        "$value": 1.06
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$extensions": {
          "com.larkmoor.css": "-0.045em"
        }
      },
      "stretch": {
        "$type": "number",
        "$value": 87.5,
        "$extensions": {
          "com.larkmoor.css": "87.5%"
        }
      },
      "$extensions": {
        "com.larkmoor.native": {
          "maxFontScale": 1.3
        }
      }
    },
    "title": {
      "family": {
        "$value": "{font.family.display}"
      },
      "size": {
        "$value": "{font.size.title}"
      },
      "weight": {
        "$value": "{font.weight.medium}"
      },
      "line-height": {
        "$type": "number",
        "$value": 1.14
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$extensions": {
          "com.larkmoor.css": "-0.04em"
        }
      },
      "$extensions": {
        "com.larkmoor.native": {
          "maxFontScale": 1.4
        }
      }
    },
    "heading": {
      "family": {
        "$value": "{font.family.display}"
      },
      "size": {
        "$value": "{font.size.heading}"
      },
      "weight": {
        "$value": "{font.weight.medium}"
      },
      "line-height": {
        "$type": "number",
        "$value": 1.2
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$extensions": {
          "com.larkmoor.css": "-0.035em"
        }
      },
      "$extensions": {
        "com.larkmoor.native": {
          "maxFontScale": 1.6
        }
      }
    },
    "subheading": {
      "family": {
        "$value": "{font.family.display}"
      },
      "size": {
        "$value": "{font.size.subheading}"
      },
      "weight": {
        "$value": "{font.weight.medium}"
      },
      "line-height": {
        "$type": "number",
        "$value": 1.3
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$extensions": {
          "com.larkmoor.css": "-0.03em"
        }
      },
      "$extensions": {
        "com.larkmoor.native": {
          "maxFontScale": 2
        }
      }
    },
    "body": {
      "family": {
        "$value": "{font.family.sans}"
      },
      "size": {
        "$value": "{font.size.body}"
      },
      "weight": {
        "$value": "{font.weight.regular}"
      },
      "line-height": {
        "$type": "number",
        "$value": 1.6
      }
    },
    "label": {
      "family": {
        "$value": "{font.family.mono}"
      },
      "size": {
        "$value": "{font.size.meta}"
      },
      "weight": {
        "$value": "{font.weight.regular}"
      },
      "line-height": {
        "$type": "number",
        "$value": 1.45
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$extensions": {
          "com.larkmoor.css": "0.04em"
        }
      },
      "$extensions": {
        "com.larkmoor.native": {
          "maxFontScale": 1.5
        }
      }
    },
    "code": {
      "family": {
        "$value": "{font.family.mono}"
      },
      "size": {
        "$value": "{font.size.code}"
      },
      "weight": {
        "$value": "{font.weight.regular}"
      },
      "line-height": {
        "$type": "number",
        "$value": 1.6
      }
    }
  }
}
