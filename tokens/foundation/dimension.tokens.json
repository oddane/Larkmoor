      "$value": {
        "value": 520,
        "unit": "px"
      },
      "$description": "Below this: single column for small two-column groups."
    },
    "narrow": {
      "$value": {
        "value": 760,
        "unit": "px"
      },
      "$description": "Below this: stacked editorial rows."
    },
    "medium": {
      "$value": {
        "value": 900,
        "unit": "px"
      },
      "$description": "Below this: mobile navigation, single-column section heads."
    },
    "wide": {
      "$value": {
        "value": 1100,
        "unit": "px"
      },
      "$description": "At or above this: secondary wayfinding such as side rails."
