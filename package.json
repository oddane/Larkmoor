{
  "name": "@larkmoor/design-system",
  "version": "0.3.0",
  "description": "Tokens, layout primitives, accessible components and themes for websites and apps: CSS/JS for the web, plus React Native, SwiftUI and Jetpack Compose outputs.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "tokens",
    "README.md",
    "CHANGELOG.md",
    "ATTRIBUTION.md",
    "LICENSE",
    "NOTICE",
    "docs/guides/THEMING.md",
    "docs/guides/MIGRATION.md",
    "docs/guides/PLATFORMS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/larkmoor.d.ts",
      "default": "./dist/larkmoor.js"
    },
    "./larkmoor.css": "./dist/larkmoor.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./themes/*": "./dist/themes/*",
    "./tokens.json": "./dist/tokens.json",
    "./breakpoints": {
      "types": "./dist/breakpoints.d.ts",
      "default": "./dist/breakpoints.mjs"
    },
    "./scss/breakpoints": "./dist/_breakpoints.scss",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json",
    "./react-native": {
      "types": "./dist/react-native/index.d.ts",
      "default": "./dist/react-native/index.js"
    },
    "./native/tokens.json": "./dist/native/tokens.json",
    "./ios/*": "./dist/ios/*",
    "./android/*": "./dist/android/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.mjs\"",
    "test": "npm run build && npm run typecheck && npm run test:unit && npm run test:browser",
    "test:update-baselines": "UPDATE_BASELINES=1 node --test --test-concurrency=1 tests/browser/visual.test.mjs",
    "examples": "node scripts/sync-examples.mjs",
    "serve": "node scripts/serve.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "evidence": "node scripts/evidence.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "esbuild": "0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oddane/Larkmoor.git"
  },
  "keywords": [
    "accessibility",
    "css",
    "design-system",
    "design-tokens",
    "dtcg",
    "jetpack-compose",
    "mobile",
    "react-native",
    "swiftui",
    "theming",
    "wcag"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-safe-area-context": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    }
  }
}
